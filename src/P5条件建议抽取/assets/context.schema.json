{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "抽取Agent可见上下文（无URL、作者或来源偏移）",
  "type": "object",
  "properties": {
    "package_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "active_scenic_code": {
      "type": "string",
      "enum": [
        "GZCL",
        "JZG",
        "ZHCL"
      ]
    },
    "package_kind": {
      "type": "string",
      "enum": [
        "route",
        "route_fragment",
        "paragraph"
      ]
    },
    "heading": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "scene_poi_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "\\S"
          },
          "kind": {
            "const": "POI"
          },
          "role": {
            "type": "string",
            "enum": [
              "attraction",
              "support"
            ]
          },
          "subtype": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "role",
          "subtype"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "scene_transport_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "\\S"
          },
          "kind": {
            "const": "TRANSPORT"
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 200
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "block_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000,
            "pattern": "\\S"
          },
          "source_kind": {
            "type": "string"
          },
          "source_group": {
            "type": "string"
          }
        },
        "required": [
          "block_id",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 200
    },
    "local_mentions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mention_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "type": {
            "type": "string",
            "enum": [
              "POI",
              "TRANSPORT",
              "TIME"
            ]
          },
          "entity_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "canonical_name": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "poi_role": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "attraction",
                  "support"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "subtype": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "time_context_text": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "mention_id",
          "text",
          "type",
          "entity_id",
          "canonical_name",
          "poi_role",
          "subtype",
          "time_context_text"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 3000
    },
    "p3_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "route_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "pattern": "\\S"
          },
          "nature": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "scope": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "granularity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "\\S"
                },
                "index": {
                  "type": "integer",
                  "minimum": 1
                },
                "poi_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "\\S"
                  },
                  "minItems": 0,
                  "maxItems": 64,
                  "uniqueItems": true
                },
                "transport_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "\\S"
                  },
                  "minItems": 0,
                  "maxItems": 64,
                  "uniqueItems": true
                },
                "unmapped_mentions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "\\S"
                  },
                  "minItems": 0,
                  "maxItems": 64
                },
                "normalized_links": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500,
                        "pattern": "\\S"
                      },
                      "entity_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "pattern": "\\S"
                      },
                      "target_p2_mention_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "pattern": "\\S"
                      },
                      "method": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "text",
                      "entity_id",
                      "target_p2_mention_id",
                      "method"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "maxItems": 64
                },
                "context_transport_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "\\S"
                  },
                  "minItems": 0,
                  "maxItems": 64,
                  "uniqueItems": true
                },
                "day": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "period": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "\\S"
                },
                "order_group": {
                  "anyOf": [
                    {
                      "type": [
                        "string",
                        "integer"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "evidence_text": {
                  "type": "string"
                },
                "clock_texts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "duration_texts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "activity_texts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "mention_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "step_id",
                "index",
                "poi_ids",
                "transport_ids",
                "unmapped_mentions",
                "normalized_links",
                "context_transport_ids",
                "day",
                "period",
                "order_group"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 1000
          },
          "order_relations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "before": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "\\S"
                },
                "after": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "\\S"
                }
              },
              "required": [
                "before",
                "after"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 2000
          }
        },
        "required": [
          "route_id",
          "nature",
          "scope",
          "granularity",
          "steps",
          "order_relations"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 30
    },
    "eligible_references": {
      "type": "object",
      "properties": {
        "poi_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "transport_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "route_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "pattern": "\\S"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "poi_ids",
        "transport_ids",
        "route_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "package_key",
    "active_scenic_code",
    "package_kind",
    "heading",
    "scene_poi_registry",
    "scene_transport_registry",
    "blocks",
    "local_mentions",
    "p3_routes",
    "eligible_references"
  ],
  "additionalProperties": false
}
